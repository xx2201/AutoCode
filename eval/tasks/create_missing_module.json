{
  "id": "create_missing_module",
  "title": "Create a missing module to satisfy an import",
  "prompt": "Read main.py, create whatever file is missing so the program runs, and verify with `python main.py`.",
  "fixture": "create_missing_module",
  "tags": ["creation", "write-file", "verification"],
  "trials": 1,
  "approval_mode": "approve_all",
  "expectations": {
    "outcome": {
      "must_contain_any": [
        { "path": "utils.py", "text": "def helper()" },
        { "path": "utils/__init__.py", "text": "def helper()" }
      ],
      "must_change_any_files": ["utils.py", "utils/__init__.py"],
      "must_not_change_files": ["main.py"],
      "verification_command": "python main.py"
    },
    "trajectory": {
      "must_use_tools": ["read_file", "write_file"],
      "forbid_tools": ["edit_file"]
    },
    "judge": {
      "focus": ["missing-file diagnosis", "correct file creation", "program should run successfully without editing main.py"]
    }
  }
}
