{
  "id": "fix_import_typo",
  "title": "Fix a misspelled import using read/edit flow",
  "prompt": "Read main.py, fix the misspelled import, and verify the result by running `python main.py`.",
  "fixture": "fix_import_typo",
  "tags": ["editing", "verification"],
  "trials": 1,
  "approval_mode": "approve_all",
  "expectations": {
    "outcome": {
      "must_contain": [
        { "path": "main.py", "text": "from utils import helper" }
      ],
      "must_not_contain": [
        { "path": "main.py", "text": "halper" }
      ],
      "must_change_files": ["main.py"],
      "verification_command": "python main.py",
      "verification_must_contain": "ok"
    },
    "trajectory": {
      "must_use_tools": ["read_file", "edit_file"],
      "require_read_before_edit": ["main.py"]
    },
    "efficiency": {
      "max_steps": 12,
      "max_tool_calls": 8
    }
  }
}
