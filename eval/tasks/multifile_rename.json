{
  "id": "multifile_rename",
  "title": "Rename a misspelled function across files",
  "prompt": "Rename the misspelled function `substract` to `subtract` everywhere it is used, then verify with `python main.py`.",
  "fixture": "multifile_rename",
  "tags": ["multifile", "editing", "verification"],
  "trials": 1,
  "approval_mode": "approve_all",
  "expectations": {
    "outcome": {
      "must_contain": [
        { "path": "calc.py", "text": "def subtract(a, b):" },
        { "path": "main.py", "text": "from calc import subtract" }
      ],
      "must_not_contain": [
        { "path": "calc.py", "text": "substract" },
        { "path": "main.py", "text": "substract" }
      ],
      "must_change_files": ["calc.py", "main.py"],
      "verification_command": "python main.py",
      "verification_must_contain": "2"
    },
    "trajectory": {
      "must_use_tools": ["read_file", "edit_file"]
    },
    "efficiency": {
      "max_steps": 14,
      "max_tool_calls": 10
    },
    "judge": {
      "focus": ["cross-file consistency", "verification discipline"]
    }
  }
}
